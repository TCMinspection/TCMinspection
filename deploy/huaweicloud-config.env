# 华为云部署环境配置模板
# 请根据您的华为云账号信息修改以下配置

# ===========================================
# 华为云认证配置
# ===========================================
# 获取方式：华为云控制台 -> 我的凭证 -> 访问密钥
HUAWEICLOUD_SDK_AK=your-access-key-here
HUAWEICLOUD_SDK_SK=your-secret-key-here
# 获取方式：华为云控制台 -> 我的凭证 -> 项目列表
HUAWEICLOUD_SDK_PROJECT_ID=your-project-id-here
# 华为云区域（例如：cn-north-4 华北-北京四）
HUAWEICLOUD_REGION=cn-north-4

# ===========================================
# 应用基础配置
# ===========================================
FLASK_ENV=production
SECRET_KEY=your-very-secure-secret-key-here
DEBUG=False

# ===========================================
# OpenAI API配置
# ===========================================
OPENAI_API_KEY=sk-or-v1-your-openai-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-4

# ===========================================
# 华为云对象存储OBS配置（可选）
# ===========================================
OBS_BUCKET_NAME=tcm-inspection-bucket
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_ACCESS_KEY=your-obs-access-key
OBS_SECRET_KEY=your-obs-secret-key

# ===========================================
# 应用目录配置
# ===========================================
UPLOAD_FOLDER=/home/tcmuser/tcm-inspection/uploads
TEMP_FOLDER=/home/tcmuser/tcm-inspection/temp
REPORTS_FOLDER=/home/tcmuser/tcm-inspection/reports
MODELS_FOLDER=/home/tcmuser/tcm-inspection/models
CONVERSATION_FOLDER=/home/tcmuser/tcm-inspection/conversation_memory

# ===========================================
# 服务器配置
# ===========================================
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/home/tcmuser/tcm-inspection/logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ===========================================
# 数据库配置（如果使用）
# ===========================================
# DATABASE_URL=postgresql://username:password@localhost/dbname

# ===========================================
# Redis配置（如果使用缓存）
# ===========================================
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# 监控配置
# ===========================================
HEALTH_CHECK_INTERVAL=300  # 5分钟
BACKUP_INTERVAL=86400     # 24小时

# ===========================================
# 安全配置
# ===========================================
CORS_ORIGINS=*
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=3600

# ===========================================
# AI模型配置
# ===========================================
MINDSPORE_DEVICE=CPU
# 如果使用昇腾芯片，设置为：Ascend
# MINDSPORE_DEVICE=Ascend

# ===========================================
# 邮件配置（用于通知）
# ===========================================
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password